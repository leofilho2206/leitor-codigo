import { useState, useRef } from "react";
import { Upload, Copy, Check, FileText, Image } from "lucide-react";
import { Button } from "/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "/components/ui/card";
import { Input } from "/components/ui/input";
import { Label } from "/components/ui/label";

const BarcodeReader = () => {
  const [file, setFile] = useState<File | null>(null);
  const [fileType, setFileType] = useState<'image' | 'pdf' | null>(null);
  const [filePreview, setFilePreview] = useState<string | null>(null);
  const [barcodeData, setBarcodeData] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const barcodeInputRef = useRef<HTMLInputElement>(null);

  const processImageFile = (file: File): Promise<string> => {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => resolve(e.target?.result as string);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  };

  const processPdfFile = async (file: File): Promise<string> => {
    // Simulação de processamento de PDF - em produção, usar biblioteca como pdf.js
    // Esta é uma simulação que retorna uma imagem placeholder representando a primeira página
    return "https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/f4f52c3b-e578-4f18-a7e3-e4c578deba21.png";
  };

  const extractBarcodeFromFile = async (file: File, type: 'image' | 'pdf'): Promise<string> => {
    // Simulação de extração de código de barras
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    // Dados mockados - em produção, integrar com biblioteca real de OCR/barcode
    const mockBarcodes = {
      image: "23793.38128 60007.271308 99000.063305 9 00010000000000",
      pdf: "84670000001435900240200240400000000000006100"
    };
    
    return mockBarcodes[type];
  };

  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const uploadedFile = event.target.files?.[0];
    if (!uploadedFile) return;

    setError(null);
    setBarcodeData(null);
    setFile(uploadedFile);

    // Determinar o tipo de arquivo
    let type: 'image' | 'pdf' | null = null;
    if (uploadedFile.type.startsWith('image/')) {
      type = 'image';
    } else if (uploadedFile.type === 'application/pdf' || uploadedFile.name.toLowerCase().endsWith('.pdf')) {
      type = 'pdf';
    }

    if (!type) {
      setError("Formato de arquivo não suportado. Use imagens (JPG, PNG) ou PDF.");
      return;
    }

    setFileType(type);
    setIsLoading(true);

    try {
      // Processar visualização do arquivo
      let previewUrl: string;
      if (type === 'image') {
        previewUrl = await processImageFile(uploadedFile);
      } else {
        previewUrl = await processPdfFile(uploadedFile);
      }
      setFilePreview(previewUrl);

      // Extrair código de barras
      const barcode = await extractBarcodeFromFile(uploadedFile, type);
      setBarcodeData(barcode);
      setError(null);

    } catch (err) {
      setError(
        type === 'image' 
          ? "Não foi possível processar a imagem. Tente com um arquivo mais nítido."
          : "Não foi possível processar o PDF. Verifique se o arquivo está válido."
      );
    } finally {
      setIsLoading(false);
    }
  };

  const handleCopyToClipboard = async () => {
    if (!barcodeData) return;

    try {
      await navigator.clipboard.writeText(barcodeData);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch (err) {
      // Fallback para navegadores antigos
      if (barcodeInputRef.current) {
        barcodeInputRef.current.select();
        document.execCommand('copy');
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
      }
    }
  };

  const handleDragOver = (e: React.DragEvent) => {
    e.preventDefault();
  };

  const handleDrop = (e: React.DragEvent) => {
    e.preventDefault();
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      const uploadedFile = files[0];
      
      // Verificar tipo de arquivo
      let type: 'image' | 'pdf' | null = null;
      if (uploadedFile.type.startsWith('image/')) {
        type = 'image';
      } else if (uploadedFile.type === 'application/pdf' || uploadedFile.name.toLowerCase().endsWith('.pdf')) {
        type = 'pdf';
      }

      if (type) {
        const event = {
          target: {
            files: [uploadedFile]
          }
        } as unknown as React.ChangeEvent<HTMLInputElement>;
        handleFileUpload(event);
      } else {
        setError("Formato de arquivo não suportado. Use imagens (JPG, PNG) ou PDF.");
      }
    }
  };

  const getFileIcon = () => {
    if (!fileType) return <Upload className="w-12 h-12 mx-auto text-gray-400" />;
    
    return fileType === 'image' 
      ? <Image className="w-12 h-12 mx-auto text-blue-400" />
      : <FileText className="w-12 h-12 mx-auto text-red-400" />;
  };

  const getFileTypeText = () => {
    if (!fileType) return "Arraste e solte uma imagem ou PDF aqui, ou clique para selecionar";
    
    return fileType === 'image'
      ? "Arquivo de imagem carregado. Clique para trocar."
      : "Documento PDF carregado. Clique para trocar.";
  };

  return (
    <div className="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
      <div className="max-w-2xl mx-auto">
        <Card className="w-full">
          <CardHeader>
            <CardTitle className="text-2xl font-bold text-center">
              Leitor de Código de Barras
            </CardTitle>
            <CardDescription className="text-center">
              Faça upload de uma foto do seu boleto ou documento PDF para ler o código de barras
            </CardDescription>
          </CardHeader>
          
          <CardContent className="space-y-6">
            {/* Upload Area */}
            <div
              className="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center cursor-pointer hover:border-blue-400 transition-colors"
              onDragOver={handleDragOver}
              onDrop={handleDrop}
              onClick={() => fileInputRef.current?.click()}
            >
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*,.pdf"
                onChange={handleFileUpload}
                className="hidden"
              />
              
              {isLoading ? (
                <div className="space-y-4">
                  <div className="w-16 h-16 mx-auto border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin"></div>
                  <p className="text-gray-600">Processando arquivo...</p>
                </div>
              ) : filePreview ? (
                <div className="space-y-4">
                  <div className="relative">
                    <img
                      src={filePreview}
                      alt={
                        fileType === 'image' 
                          ? "Pré-visualização do boleto enviado mostrando detalhes do documento com código de barras visível" 
                          : "Visualização da primeira página do documento PDF enviado contendo código de barras"
                      }
                      className="mx-auto max-h-48 max-w-full object-contain rounded"
                    />
                    <div className="absolute top-2 right-2 bg-white bg-opacity-90 rounded-full p-1">
                      {fileType === 'image' ? (
                        <Image className="w-4 h-4 text-blue-600" />
                      ) : (
                        <FileText className="w-4 h-4 text-red-600" />
                      )}
                    </div>
                  </div>
                  <p className="text-gray-600">{getFileTypeText()}</p>
                </div>
              ) : (
                <div className="space-y-4">
                  {getFileIcon()}
                  <p className="text-gray-600">{getFileTypeText()}</p>
                </div>
              )}
            </div>

            {/* Info sobre tipos de arquivo */}
            <div className="flex justify-center gap-4 text-sm text-gray-600">
              <div className="flex items-center gap-1">
                <Image className="w-4 h-4 text-blue-500" />
                <span>Imagens</span>
              </div>
              <div className="flex items-center gap-1">
                <FileText className="w-4 h-4 text-red-500" />
                <span>PDF</span>
              </div>
            </div>

            {/* Error Message */}
            {error && (
              <div className="bg-red-50 border border-red-200 rounded-md p-4">
                <p className="text-red-800 text-sm">{error}</p>
              </div>
            )}

            {/* Barcode Result */}
            {barcodeData && (
              <div className="space-y-4">
                <Label htmlFor="barcode">Código de Barras Encontrado:</Label>
                <div className="relative">
                  <Input
                    ref={barcodeInputRef}
                    id="barcode"
                    value={barcodeData}
                    readOnly
                    className="pr-12 font-mono text-sm"
                  />
                  <Button
                    size="sm"
                    variant="outline"
                    className="absolute right-1 top-1 h-8 w-8 p-0"
                    onClick={handleCopyToClipboard}
                  >
                    {copied ? (
                      <Check className="h-4 w-4 text-green-600" />
                    ) : (
                      <Copy className="h-4 w-4" />
                    )}
                  </Button>
                </div>
                <p className="text-sm text-gray-600">
                  Clique no ícone de cópia para copiar o código de barras
                </p>
              </div>
            )}

            {/* Instructions */}
            <div className="bg-blue-50 border border-blue-200 rounded-md p-4">
              <h3 className="font-semibold text-blue-800 mb-2">Como usar:</h3>
              <ul className="text-blue-700 text-sm space-y-1">
                <li>• Envie uma foto nítida do código de barras ou um documento PDF</li>
                <li>• Para imagens: certifique-se que o código esteja bem visível</li>
                <li>• Para PDFs: o sistema extrairá da primeira página</li>
                <li>• Evite reflexos e sombras nos arquivos</li>
                <li>• O código será automaticamente detectado e copiável</li>
              </ul>
            </div>

            {/* Formatos suportados */}
            <div className="bg-gray-50 border border-gray-200 rounded-md p-4">
              <h3 className="font-semibold text-gray-800 mb-2">Formatos suportados:</h3>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-700">
                <div>
                  <h4 className="font-medium mb-1 flex items-center gap-1">
                    <Image className="w-4 h-4 text-blue-500" />
                    Imagens
                  </h4>
                  <p>JPG, PNG, GIF, WEBP</p>
                </div>
                <div>
                  <h4 className="font-medium mb-1 flex items-center gap-1">
                    <FileText className="w-4 h-4 text-red-500" />
                    Documentos
                  </h4>
                  <p>PDF</p>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  );
};

export default BarcodeReader;
